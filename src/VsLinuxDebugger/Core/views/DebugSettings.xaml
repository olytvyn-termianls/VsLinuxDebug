<Window x:Class="VsLinuxDebugger.Core.DebugSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VsLinuxDebugger Settings" Width="550" Height="570" ResizeMode="CanResizeWithGrip" MinHeight="375" MinWidth="375"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="5,15,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.ColumnSpan="5">

            <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Selected Connection:" VerticalAlignment="Center" Margin="5" />
        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SettingsContainer.DeviceConnections}" DisplayMemberPath="FullDescription"  SelectedValue="{Binding SettingsContainer.SelectedId, Mode=TwoWay}" SelectedValuePath="Id" Margin="5"/>
        <!--SelectionChanged="DeviceConnections_SelectionChanged"-->
        <Button Grid.Row="0" Grid.Column="2" Click="Add" Margin="5" Padding="5,2">New</Button>
                <Button Grid.Row="0" Grid.Column="3" Click="Delete" Margin="5" Padding="5,2">Remove</Button>
            </Grid>
        </Grid>
        <TabControl Grid.Row="1" Grid.ColumnSpan="5">
            <TabItem Header="Remote credentials">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/>
                  <ColumnDefinition Width="62"/>
                  <ColumnDefinition Width="9"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="127.997"/>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Host IP Address -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Host IP Address" VerticalAlignment="Center" Margin="5,0,5,0" Grid.ColumnSpan="5" />
          <TextBox Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="2" Text="{Binding SettingsContainer.CurrentUserSettings.HostIp}" Margin="5,5,5,5" />

                <!-- Host Port Number -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Host Port Number (22)" VerticalAlignment="Center" Margin="5,0,5,0" Grid.ColumnSpan="5" />
          <TextBox Grid.Row="2" Grid.Column="5" Grid.ColumnSpan="2" Text="{Binding SettingsContainer.CurrentUserSettings.HostPort}" Margin="5,5,5,5" />

                <!-- User Name -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="User Name" VerticalAlignment="Center" Margin="5,0,5,0" Grid.ColumnSpan="5" />
          <TextBox Grid.Row="3" Grid.Column="5" Grid.ColumnSpan="2" Text="{Binding SettingsContainer.CurrentUserSettings.UserName}" Margin="5,5,5,5" />

                <!-- User Password -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="User Password" VerticalAlignment="Center" Margin="5,0,5,0" Grid.ColumnSpan="5" />
          <TextBox Grid.Row="4" Grid.Column="5" Grid.ColumnSpan="2" Text="{Binding SettingsContainer.CurrentUserSettings.UserPass}" Margin="5,5,5,5" />

          <!-- User Group Name -->
          <TextBlock Grid.Row="5" Grid.Column="0" Text="User Group Name (optional)" VerticalAlignment="Center" Margin="5,0,5,0" Grid.ColumnSpan="5" />
          <TextBox Grid.Row="5" Grid.Column="5" Grid.ColumnSpan="2" Text="{Binding SettingsContainer.CurrentUserSettings.UserGroupName}" Margin="5,5,5,5" />

          <!-- SSH Key File Enabled --><!--
                <TextBlock Grid.Row="6" Grid.Column="0" Text="SSH Key File Enabled" VerticalAlignment="Center" Margin="5,0,5,0" Grid.ColumnSpan="5" />
          <CheckBox Grid.Row="6" Grid.Column="5" IsChecked="{Binding SettingsContainer.CurrentUserSettings.UserPrivateKeyEnabled}" Margin="5,5,5,5" />

                --><!-- SSH Private Key File --><!--
                <TextBlock Grid.Row="7" Grid.Column="0" Text="SSH Private Key File (optional)" VerticalAlignment="Center" Margin="5,0,5,0" Grid.ColumnSpan="5" />
          <TextBox Grid.Row="7" Grid.Column="5" Grid.ColumnSpan="2" Text="{Binding SettingsContainer.CurrentUserSettings.UserPrivateKeyPath}" Margin="5,5,5,5" />

                --><!-- SSH Private Key Password --><!--
                <TextBlock Grid.Row="8" Grid.Column="0" Text="SSH Private Key Password (optional)" VerticalAlignment="Center" Margin="5,0,5,0" Grid.ColumnSpan="5" />
          <PasswordBox   Grid.Row="8" Grid.Column="5" Grid.ColumnSpan="2" x:Name="SshPasswordBox" PasswordChanged="SshPasswordBox_PasswordChanged" Margin="5,5,5,5" />

                --><!-- Use SSH.exe instead of PLINK --><!--
          <TextBlock Grid.Row="9" Grid.Column="0" Grid.RowSpan="2" Text="Use SSH.exe with integrated user/[..]/.ssh/id_rsa instead of PLINK" VerticalAlignment="Center" Margin="5,0,5,0" Grid.ColumnSpan="5" TextWrapping="Wrap" />
          <CheckBox Grid.Row="9" Grid.Column="5" IsChecked="{Binding SettingsContainer.CurrentUserSettings.UseSSHExeEnabled}" Margin="5,5,5,5" />-->
              </Grid>
            </TabItem>
            <TabItem Header="Remote Debugger">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="230"/>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Remote Debugging Section -->
          <TextBlock Grid.Row="1" Grid.Column="0" Text=".NET executable:" VerticalAlignment="Center" Margin="5" />
          <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SettingsContainer.CurrentUserSettings.RemoteDotNetPath}" Margin="5" />
                
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Upload Debug build to folder:" VerticalAlignment="Center" Margin="5" />
          <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SettingsContainer.CurrentUserSettings.RemoteDeployDebugBasePath}" Margin="5" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Upload Release build to folder:" VerticalAlignment="Center" Margin="5" />
          <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SettingsContainer.CurrentUserSettings.RemoteDeployReleaseBasePath}" Margin="5" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Append project name to upload path:" VerticalAlignment="Center" Margin="5" />
          <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding SettingsContainer.CurrentUserSettings.RemoteDebugAppendProjName}" Margin="5" />

          <TextBlock Grid.Row="6" Grid.Column="0" Text="Visual Studio Local Debugger Path:" VerticalAlignment="Center" Margin="5" />
          <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SettingsContainer.CurrentUserSettings.LocalVsDbgRootPath}" Margin="5" />

          <TextBlock Grid.Row="7" Grid.Column="0" Text="Visual Studio Remote Debugger Path:" VerticalAlignment="Center" Margin="5" />
          <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SettingsContainer.CurrentUserSettings.RemoteVsDbgBasePath}" Margin="5" />

               
                
              </Grid>
            </TabItem>
            <TabItem Header="Debug script">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Pre-Debug script (To kill previous debugging session):" VerticalAlignment="Center" Margin="5" />
                    <Button Grid.Row="0" Grid.Column="1" MinWidth="100" Click="SetDefaultPreDebugScript" Margin="5" Padding="5,2">Set default Pre-Debug script</Button>
          <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" Text="{Binding SettingsContainer.CurrentUserSettings.PreLaunchCommand}"/>
                   
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="After-Debug script:" VerticalAlignment="Center" Margin="5" />
                    <Button Grid.Row="2" Grid.Column="1" MinWidth="100" Click="SetDefaultDebugScript" Margin="5" Padding="5,2">Set default Debug script</Button>
          <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" Text="{Binding SettingsContainer.CurrentUserSettings.PostLaunchCommand}"/>
                   
                    <Expander Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" 
                              Name="myExpander" 
                              Header="Script information" 
                              ExpandDirection="Down" IsExpanded="False">
                        <TextBlock Text="{Binding SettingsContainer.CurrentUserSettings.SupportedScriptParameters}" VerticalAlignment="Center" Margin="0,5" Background="LightYellow" Padding="10" TextWrapping="Wrap"/>
                    </Expander>
                </Grid>
            </TabItem>
            <TabItem Header="Local settings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="127.997"/>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="PLink Local Path (blank to use embedded)" VerticalAlignment="Center" Margin="5,0,5,0" Grid.ColumnSpan="5" />
          <TextBox Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="2" Text="{Binding SettingsContainer.CurrentUserSettings.LocalPLinkPath}" Margin="5,5,5,5" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="PLink user prompts auto confiramtion" VerticalAlignment="Center" Margin="5,0,5,0" Grid.ColumnSpan="5" />
          <CheckBox Grid.Row="2" Grid.Column="5" IsChecked="{Binding SettingsContainer.CurrentUserSettings.PlinkAutoConfirmEnabled}" Margin="5,5,5,5" />
          

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Delete 'launch.json' after build." VerticalAlignment="Center" Margin="5,0,5,0" Grid.ColumnSpan="5" />
          <CheckBox Grid.Row="3" Grid.Column="5" IsChecked="{Binding SettingsContainer.CurrentUserSettings.DeleteLaunchJsonAfterBuild}" Margin="5,5,5,5" />

                    <!--<TextBlock Grid.Row="3" Grid.Column="0" Text="Switch to LinuxDbg Output on Build" VerticalAlignment="Center" Margin="5,0,5,0" Grid.ColumnSpan="5" />
          <CheckBox Grid.Row="3" Grid.Column="5" IsChecked="{Binding SettingsContainer.CurrentUserSettings.LocalSwitchLinuxDbgOutput}" Margin="5,5,5,5" />-->

                </Grid>
            </TabItem>
        </TabControl>
        <Button Grid.Row="10" Grid.Column="0" MinWidth="100" Click="Save" Margin="5" >Save</Button>
        <Button Grid.Row="10" Grid.Column="1" MinWidth="100" Click="Cancel" Margin="5" >Cancel</Button>
        <Button Grid.Row="10" Grid.Column="3" MinWidth="100" Click="SaveAs" Margin="5" >Save to file ...</Button>
        <Button Grid.Row="10" Grid.Column="4" MinWidth="100" Click="LoadFrom" Margin="5" >Load from file ...</Button>
    </Grid>
</Window>